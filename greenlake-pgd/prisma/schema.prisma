  infrastructure_transport_routes_destination_hub_idToinfrastructure infrastructure  @relation("transport_routes_destination_hub_idToinfrastructure", fields: [destination_hub_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_destination_hub")

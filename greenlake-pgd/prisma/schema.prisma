model event {
  event_id                               String   @id @db.Uuid
  city_id                                String?  @db.Uuid
  venue_id                               String?  @db.Uuid
  event_type                             String?  @db.VarChar(50)
  name                                   String   @db.VarChar(255)
  description                            String?  @db.Text
  start_date                             DateTime?
  end_date                               DateTime?
  expected_attendance                    Int?
  actual_attendance                      Int?
  ticket_price                           Float?
  status                                 String?  @db.VarChar(20)
  organizer                              String?  @db.VarChar(255)
  contact_email                          String?  @db.VarChar(255)
  contact_phone                          String?  @db.VarChar(50)
  is_free                                Boolean?
  is_private                             Boolean?
  requires_registration                  Boolean?
  age_restriction                        String?  @db.VarChar(20)
  has_food                               Boolean?
  has_alcohol                            Boolean?
  is_family_friendly                     Boolean?
  is_outdoor                             Boolean?
  weather_dependent                      Boolean?
  has_parking                            Boolean?
  has_accessible_entrance                Boolean?
  has_wifi                               Boolean?
  has_translation_services               Boolean?
  has_childcare                          Boolean?
  has_medical_staff                      Boolean?
  has_security                           Boolean?
  has_emergency_exits                    Boolean?
  has_first_aid                          Boolean?
  has_fire_extinguishers                 Boolean?
  has_smoking_area                       Boolean?
  streaming_available                    Boolean?
  virtual_attendance_option              Boolean?
  social_media_hashtag                   String?  @db.VarChar(100)
  early_bird_discount                    Boolean?
  group_discount_available               Boolean?
  student_discount_available             Boolean?
  senior_discount_available              Boolean?
  military_discount_available            Boolean?
  vip_option_available                   Boolean?
  merchandise_available                  Boolean?
  photography_allowed                    Boolean?
  video_recording_allowed                Boolean?
  refund_policy                          String?  @db.VarChar(50)
  weather_contingency_plan               Boolean?
  sustainability_initiative              Boolean?
  community_impact_score                 Int?
  expected_economic_impact               Int?
  post_event_survey_planned              Boolean?
  vendor_count                           Int?
  sponsor_count                          Int?
  staff_count                            Int?
  volunteer_count                        Int?
  social_media_reach                     Int?
  registration_deadline                  DateTime?
  setup_days_required                    Int?
  teardown_days_required                 Int?
  local_accommodation_partners           Int?
  transportation_partners                Int?
  marketing_budget                       Int?
  satisfaction_score                     Float?
  return_attendee_percentage             Float?
  press_coverage_level                   String?  @db.VarChar(20)
  weather_during_event                   String?  @db.VarChar(20)
  ticket_sales_progress                  Float?
  early_registration_discount_percentage Int?
  projected_attendance                   Int?
  event_risk_score                       Int?
  marketing_campaign_status              String?  @db.VarChar(50)
  revenue_generated                      Int?
  expenses                               Int?
  profit                                 Int?
  attendance_vs_expected                 Float?
  sponsor_satisfaction                   Float?
  media_mentions                         Int?
  genre                                  String?  @db.VarChar(50)
  sport                                  String?  @db.VarChar(50)
  art_style                              String?  @db.VarChar(50)
  topic                                  String?  @db.VarChar(100)
  culture                                String?  @db.VarChar(50)
  cuisine_type                           String?  @db.VarChar(50)
  play_name                              String?  @db.VarChar(100)
  game                                   String?  @db.VarChar(50)
  comedian                               String?  @db.VarChar(100)
  company                                String?  @db.VarChar(100)
  product                                String?  @db.VarChar(100)  // Relaciones
  city                                   cities? @relation(fields: [city_id], references: [id])
  venue                                  infrastructure? @relation(fields: [venue_id], references: [id])

  @@map("events")
}


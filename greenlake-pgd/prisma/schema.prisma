  water_conservation_systems Boolean?
  waste_reduction_program    Boolean?
  infrastructure             infrastructure @relation(fields: [infra_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model music {
  id               String         @id
  artists          String?
  album_name       String?
  track_name       String?
  duration_ms      BigInt?
  explicit         Boolean?
  danceability     Float?
  energy           Float?
  key              BigInt?
  loudness         Float?
  mode             BigInt?
  speechiness      Float?
  acousticness     Float?
  instrumentalness Float?
  liveness         Float?
  valence          Float?
  tempo            Float?
  time_signature   BigInt?
  track_genre      String?
  people_music     people_music[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model parcels {
  parcel_id    String  @id @db.VarChar(100)
  city_id      String  @db.Uuid
  area_m2      Decimal @db.Decimal
  centroid_lat Decimal @db.Decimal
  centroid_lon Decimal @db.Decimal
  vertices     String
  cities       cities  @relation(fields: [city_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_parcels_city")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model people {
  id                String             @id @db.Uuid
  city_id           String             @db.Uuid
  first_name        String
  last_name         String
  birth_date        DateTime           @db.Date
  job_sector        String
  education         String?
  employment_status String?
  income            Int?
  personality       String
  cities            cities             @relation(fields: [city_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  people_music      people_music[]
  review            review[]
  tourism_trips     tourism_trips[]    
  vip_network_data  vip_network_data[]

  @@index([city_id], map: "idx_people_city_id")
}

model people_music {
  people_id String @db.Uuid
  music_id  String
  music     music  @relation(fields: [music_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  people    people @relation(fields: [people_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([people_id, music_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model review {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  people_id      String         @db.Uuid
  infra_id       String         @db.Uuid
  datetime       DateTime?      @default(now()) @db.Timestamptz(6)
  description    String?
  stars          Int?
  infrastructure infrastructure @relation(fields: [infra_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_review_infrastructure")
  people         people         @relation(fields: [people_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_review_people")

  @@index([datetime], map: "idx_review_datetime")
  @@index([infra_id], map: "idx_review_infra_id")
  @@index([people_id], map: "idx_review_people_id")
}

model roads {
  origin_city_id                      String?                   @db.Uuid
  target_city_id                      String?                   @db.Uuid
  toll                                Float?
  id                                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  geometry                            Unsupported("geography")?
  length_km                           Float?
  cities_roads_origin_city_idTocities cities?                   @relation("roads_origin_city_idTocities", fields: [origin_city_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_city1")
  cities_roads_target_city_idTocities cities?                   @relation("roads_target_city_idTocities", fields: [target_city_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_city2")
  sensors                             sensors[]
  service_area                        service_area[]
}


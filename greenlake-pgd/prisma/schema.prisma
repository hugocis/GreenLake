generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_LOOPERS")
}

model cities {
  id                                                            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                                          String?                   @db.VarChar(255)
  capital                                                       Boolean?
  state_id                                                      String?                   @db.Uuid
  has_harbor                                                    Boolean?                  @default(false)
  location                                                      Unsupported("geometry")?
  states                                                        states?                   @relation(fields: [state_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  city_borders                                                  city_borders?
  electric_rental_vehicle                                       electric_rental_vehicle[]
  events                                                        events[]
  infrastructure                                                infrastructure[]
  parcels                                                       parcels[]
  people                                                        people[]
  roads_roads_origin_city_idTocities                            roads[]                   @relation("roads_origin_city_idTocities")
  roads_roads_target_city_idTocities                            roads[]                   @relation("roads_target_city_idTocities")
  sensors                                                       sensors[]
  transport_routes_transport_routes_destination_city_idTocities transport_routes[]        @relation("transport_routes_destination_city_idTocities")
  transport_routes_transport_routes_origin_city_idTocities      transport_routes[]        @relation("transport_routes_origin_city_idTocities")

  @@index([location], map: "idx_cities_location", type: Gist)
}

model city_borders {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  city_id      String    @unique(map: "city_borders_unique_city") @db.Uuid
  vertices     String
  area_km2     Decimal   @db.Decimal
  bounding_box Decimal[] @db.Decimal
  cities       cities    @relation(fields: [city_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([city_id], map: "idx_city_borders_city_id")
}

model electric_rental_vehicle {
  id                   String   @id @db.Uuid
  city_id              String?  @db.Uuid
  vin                  String?  @db.VarChar(10)
  model_year           Int?
  make                 String?  @db.VarChar(255)
  model                String?  @db.VarChar(255)
  electric_range       Int?
  dol_vehicle_id       BigInt?
  census_tract         BigInt?
  rental_cost_per_hour Decimal? @db.Decimal(5, 2)
  capacity             Int?
  type                 String?  @db.VarChar(50)
  cities               cities?  @relation(fields: [city_id], references: [id], onUpdate: NoAction)
}

model events {
  event_id                               String          @id @db.Uuid
  city_id                                String?         @db.Uuid
  venue_id                               String?         @db.Uuid
  event_type                             String?         @db.VarChar(50)
  name                                   String          @db.VarChar(255)
  description                            String?
  start_date                             DateTime?       @db.Timestamp(6)
  end_date                               DateTime?       @db.Timestamp(6)
  expected_attendance                    Int?
  actual_attendance                      Int?
  ticket_price                           Float?
  status                                 String?         @db.VarChar(20)
  organizer                              String?         @db.VarChar(255)
  contact_email                          String?         @db.VarChar(255)
  contact_phone                          String?         @db.VarChar(50)
  is_free                                Boolean?
  is_private                             Boolean?
  requires_registration                  Boolean?
  age_restriction                        String?         @db.VarChar(20)
  has_food                               Boolean?
  has_alcohol                            Boolean?
  is_family_friendly                     Boolean?
  is_outdoor                             Boolean?
  weather_dependent                      Boolean?
  has_parking                            Boolean?
  has_accessible_entrance                Boolean?
  has_wifi                               Boolean?
  has_translation_services               Boolean?
  has_childcare                          Boolean?
  has_medical_staff                      Boolean?
  has_security                           Boolean?
  has_emergency_exits                    Boolean?
  has_first_aid                          Boolean?
  has_fire_extinguishers                 Boolean?
  has_smoking_area                       Boolean?
  streaming_available                    Boolean?
  virtual_attendance_option              Boolean?
  social_media_hashtag                   String?         @db.VarChar(100)
  early_bird_discount                    Boolean?
  group_discount_available               Boolean?
  student_discount_available             Boolean?
  senior_discount_available              Boolean?
  military_discount_available            Boolean?
  vip_option_available                   Boolean?
  merchandise_available                  Boolean?
  photography_allowed                    Boolean?
  video_recording_allowed                Boolean?
  refund_policy                          String?         @db.VarChar(50)
  weather_contingency_plan               Boolean?
  sustainability_initiative              Boolean?
  community_impact_score                 Int?
  expected_economic_impact               Int?
  post_event_survey_planned              Boolean?
  vendor_count                           Int?
  sponsor_count                          Int?
  staff_count                            Int?
  volunteer_count                        Int?
  social_media_reach                     Int?
  registration_deadline                  DateTime?       @db.Date
  setup_days_required                    Int?
  teardown_days_required                 Int?
  local_accommodation_partners           Int?
  transportation_partners                Int?
  marketing_budget                       Int?
  satisfaction_score                     Float?
  return_attendee_percentage             Float?
  press_coverage_level                   String?         @db.VarChar(20)
  weather_during_event                   String?         @db.VarChar(20)
  ticket_sales_progress                  Float?
  early_registration_discount_percentage Int?
  projected_attendance                   Int?
  event_risk_score                       Int?
  marketing_campaign_status              String?         @db.VarChar(50)
  revenue_generated                      Int?
  expenses                               Int?
  profit                                 Int?
  attendance_vs_expected                 Float?
  sponsor_satisfaction                   Float?
  media_mentions                         Int?
  genre                                  String?         @db.VarChar(50)
  sport                                  String?         @db.VarChar(50)
  art_style                              String?         @db.VarChar(50)
  topic                                  String?         @db.VarChar(100)
  culture                                String?         @db.VarChar(50)
  cuisine_type                           String?         @db.VarChar(50)
  play_name                              String?         @db.VarChar(100)
  game                                   String?         @db.VarChar(50)
  comedian                               String?         @db.VarChar(100)
  company                                String?         @db.VarChar(100)
  product                                String?         @db.VarChar(100)
  cities                                 cities?         @relation(fields: [city_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  infrastructure                         infrastructure? @relation(fields: [venue_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model infrastructure {
  id                                                                   String                              @id @db.Uuid
  city_id                                                              String?                             @db.Uuid
  type                                                                 String                              @db.VarChar(100)
  subtype                                                              String?                             @db.VarChar(100)
  name                                                                 String?                             @db.VarChar(255)
  opening_date                                                         DateTime?                           @db.Date
  green_score                                                          Int?
  carbon_footprint_kg_per_year                                         Decimal?                            @db.Decimal
  energy_efficiency_score                                              Int?
  water_efficiency_score                                               Int?
  waste_management_score                                               Int?
  renewable_energy_percentage                                          Decimal?                            @db.Decimal
  green_certification                                                  String?
  location                                                             Unsupported("geometry")?
  events                                                               events[]
  cities                                                               cities?                             @relation(fields: [city_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  infrastructure_auto_service                                          infrastructure_auto_service?
  infrastructure_bank                                                  infrastructure_bank?
  infrastructure_daycare                                               infrastructure_daycare?
  infrastructure_fabric                                                infrastructure_fabric?
  infrastructure_gas_station                                           infrastructure_gas_station?
  infrastructure_government_building                                   infrastructure_government_building?
  infrastructure_gym                                                   infrastructure_gym?
  infrastructure_healthcare_clinic                                     infrastructure_healthcare_clinic?
  infrastructure_hospital                                              infrastructure_hospital?
  infrastructure_hotel                                                 infrastructure_hotel?
  infrastructure_laundromat                                            infrastructure_laundromat?
  infrastructure_office_building                                       infrastructure_office_building?
  infrastructure_park                                                  infrastructure_park?
  infrastructure_pet_services                                          infrastructure_pet_services?
  infrastructure_pharmacy                                              infrastructure_pharmacy?
  infrastructure_religious_building                                    infrastructure_religious_building?
  infrastructure_restaurant                                            infrastructure_restaurant?
  infrastructure_salon                                                 infrastructure_salon?
  infrastructure_school                                                infrastructure_school?
  infrastructure_senior_living                                         infrastructure_senior_living?
  infrastructure_shop                                                  infrastructure_shop?
  infrastructure_supermarket                                           infrastructure_supermarket?
  infrastructure_transportation_hub                                    infrastructure_transportation_hub?
  infrastructure_venues                                                infrastructure_venues?
  review                                                               review[]
  transport_routes_transport_routes_destination_hub_idToinfrastructure transport_routes[]                  @relation("transport_routes_destination_hub_idToinfrastructure")
  transport_routes_transport_routes_origin_hub_idToinfrastructure      transport_routes[]                  @relation("transport_routes_origin_hub_idToinfrastructure")

  @@index([city_id], map: "idx_infra_city_id")
  @@index([subtype], map: "idx_infra_subtype")
  @@index([type], map: "idx_infra_type")
  @@index([location], map: "idx_infrastructure_location", type: Gist)
}

model infrastructure_auto_service {
  infra_id                  String         @id @db.Uuid
  bay_count                 Int?
  eco_friendly_services     Boolean?
  electric_vehicle_charging Boolean?
  recycling_program         Boolean?
  infrastructure            infrastructure @relation(fields: [infra_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}


  // Relación con infrastructure
  infrastructure               infrastructure @relation(fields: [infra_id], references: [id], onDelete: Cascade)

  @@map("infrastructure_transportation_hub")
}

model infrastructure_pharmacy {
  infra_id                  String   @id @db.Uuid
  is_24hour                 Boolean?
  has_drive_thru            Boolean?
  paperless_prescriptions   Boolean?
  eco_friendly_packaging    Boolean?
  energy_efficient_lighting Boolean?

  // Relación con infrastructure
  infrastructure            infrastructure @relation(fields: [infra_id], references: [id], onDelete: Cascade)

  @@map("infrastructure_pharmacy")
}

model sensor {
  id              String   @id @db.Uuid
  sensor_type     String   @db.Text
  installed_at    DateTime?
  city_id         String?  @db.Uuid
  state_id        String?  @db.Uuid
  location        String?  @db.Text
  road_id         String?  @db.Uuid
  km_point        Float?
  industrial_zone Boolean? @default(false)
  
  // Relaciones
  city            cities?    @relation(fields: [city_id], references: [id])
  state           states?   @relation(fields: [state_id], references: [id])
  road            road?    @relation(fields: [road_id], references: [id])
  ambient_metrics sensor_metrics_ambient[]
  traffic_metrics sensor_metrics_traffic[]
  air_metrics     sensor_metrics_air[]
  water_usage_metrics sensor_metrics_water_usage[]
  water_quality_metrics sensor_metrics_water_quality[]

  @@map("sensors")
}

model sensor_metrics_ambient {
  event_time      DateTime @db.Timestamptz
  sensor_id       String   @db.Uuid
  temperature     Float?
  humidity        Float?
  solar_radiation Float?

  // Relaciones
  sensor          sensor   @relation(fields: [sensor_id], references: [id])

  @@id([event_time, sensor_id])
  @@map("sensor_metrics_ambient")
}

model sensor_metrics_traffic {
  event_time       DateTime @db.Timestamptz
  sensor_id        String   @db.Uuid
  vehicle_density  Float?
  avg_speed        Float?
  flow_rate        Float?
  occupancy        Float?
  congestion_index Float?

  // Relaciones
  sensor           sensor   @relation(fields: [sensor_id], references: [id])

  @@id([event_time, sensor_id])
  @@map("sensor_metrics_traffic")
}

model sensor_metrics_air {
  event_time DateTime @db.Timestamptz
  sensor_id  String   @db.Uuid
  pm10       Float?
  co         Float?
  co2        Float?
  no2        Float?
  o3         Float?
  so2        Float?

  // Relaciones
  sensor     sensor   @relation(fields: [sensor_id], references: [id])

  @@id([event_time, sensor_id])
  @@map("sensor_metrics_air")
}

model sensor_metrics_water_usage {
  event_time   DateTime @db.Timestamptz
  sensor_id    String   @db.Uuid
  usage_liters Float?

  // Relaciones
  sensor       sensor   @relation(fields: [sensor_id], references: [id])

  @@id([event_time, sensor_id])
  @@map("sensor_metrics_water_usage")
}

model sensor_metrics_water_quality {
  event_time        DateTime @db.Timestamptz
  sensor_id         String   @db.Uuid
  water_temperature Float?
  ph_level          Float?
  turbidity         Float?
  dissolved_oxygen  Float?
  conductivity      Float?

  // Relaciones
  sensor            sensor   @relation(fields: [sensor_id], references: [id])

  @@id([event_time, sensor_id])
  @@map("sensor_metrics_water_quality")
}


model infrastructure {
  id                           String   @id @db.Uuid
  city_id                      String?  @db.Uuid
  type                         String   @db.VarChar(100)
  subtype                      String?  @db.VarChar(100)
  name                         String?  @db.VarChar(255)
  opening_date                 DateTime? @db.Date
  green_score                  Int?
  carbon_footprint_kg_per_year Decimal?
  energy_efficiency_score      Int?
  water_efficiency_score       Int?
  waste_management_score       Int?
  renewable_energy_percentage  Decimal?
  green_certification          String?  @db.Text
  location                     Unsupported("geometry(Point,4326)")  // Relaciones
  city                         cities?     @relation(fields: [city_id], references: [id])
  events                       event[]
  routes_as_origin            transport_routes[] @relation("origin_hub")
  routes_as_destination       transport_routes[] @relation("destination_hub")
  reviews                      review[]
  infrastructure_auto_service  infrastructure_auto_service?
  infrastructure_bank          infrastructure_bank?
  infrastructure_daycare       infrastructure_daycare?
  infrastructure_fabric        infrastructure_fabric?
  infrastructure_gas_station   infrastructure_gas_station?
  infrastructure_government_building infrastructure_government_building?
  infrastructure_gym           infrastructure_gym?
  infrastructure_healthcare_clinic infrastructure_healthcare_clinic?
  infrastructure_hospital      infrastructure_hospital?
  infrastructure_hotel         infrastructure_hotel?
  infrastructure_laundromat    infrastructure_laundromat?
  infrastructure_office_building infrastructure_office_building?
  infrastructure_park          infrastructure_park?
  infrastructure_pet_services  infrastructure_pet_services?
  infrastructure_pharmacy      infrastructure_pharmacy?
  infrastructure_religious_building infrastructure_religious_building?
  infrastructure_restaurant    infrastructure_restaurant?
  infrastructure_salon         infrastructure_salon?
  infrastructure_school        infrastructure_school?
  infrastructure_senior_living infrastructure_senior_living?
  infrastructure_shop          infrastructure_shop?
  infrastructure_supermarket   infrastructure_supermarket?
  infrastructure_transportation_hub infrastructure_transportation_hub?
  infrastructure_venues        infrastructure_venues?

  @@map("infrastructure")
}

model infrastructure_shop {
  infra_id                  String   @id @db.Uuid
  size                      String?  @db.VarChar(50)
  eco_friendly_products     Boolean?
  energy_efficient_lighting Boolean?
  sustainable_packaging     Boolean?

  // Relación con infrastructure
  infrastructure            infrastructure @relation(fields: [infra_id], references: [id], onDelete: Cascade)

  @@map("infrastructure_shop")
}

model infrastructure_supermarket {
  infra_id                       String   @id @db.Uuid
  size                           String?  @db.VarChar(50)
  floor_area_m2                  Int?
  register_count                 Int?
  local_organic_products         Boolean?
  energy_efficient_refrigeration Boolean?
  waste_reduction_program        Boolean?

  // Relación con infrastructure
  infrastructure                 infrastructure @relation(fields: [infra_id], references: [id], onDelete: Cascade)

  @@map("infrastructure_supermarket")
}

model road {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  origin_city_id  String?  @db.Uuid
  target_city_id  String?  @db.Uuid
  toll            Float?
  geometry        Unsupported("geography(LineString,4326)")
  length_km       Float?

  // Relaciones
  origin_city     cities?    @relation("OriginCity", fields: [origin_city_id], references: [id])
  target_city     cities?    @relation("TargetCity", fields: [target_city_id], references: [id])
  sensors         sensor[]

  @@map("roads")
}

model infrastructure_bank {
  infra_id                  String   @id @db.Uuid
  atm_count                 Int?
  has_drive_thru            Boolean?
  paperless_operations      Boolean?
  green_investment_products Boolean?
  energy_efficient_lighting Boolean?

  // Relación
  infrastructure            infrastructure @relation(fields: [infra_id], references: [id], onDelete: Cascade)

  @@map("infrastructure_bank")
}

model infrastructure_religious_building {
  infra_id                  String   @id @db.Uuid
  solar_panels              Boolean?
  energy_efficient_lighting Boolean?
  sustainable_materials     Boolean?

  // Relación
  infrastructure            infrastructure @relation(fields: [infra_id], references: [id], onDelete: Cascade)

  @@map("infrastructure_religious_building")
}

model infrastructure_park {
  infra_id               String   @id @db.Uuid
  size                   String?  @db.VarChar(50)
  area_km2               Decimal? @db.Decimal(10, 2)
  native_plantings       Boolean?
  wildlife_habitat       Boolean?
  sustainable_irrigation Boolean?

  // Relación
  infrastructure         infrastructure @relation(fields: [infra_id], references: [id], onDelete: Cascade)

  @@map("infrastructure_park")
}

model tourism_trips {
  trip_id            String   @id @db.Uuid
  person_id          String   @db.Uuid
  route_id           String   @db.Uuid
  departure_datetime DateTime @db.Timestamp(6)
  arrival_datetime   DateTime @db.Timestamp(6)
  is_return          Boolean

  // Relaciones
  people             people   @relation(fields: [person_id], references: [id])
  transport_routes   transport_routes @relation(fields: [route_id], references: [route_id])

  @@map("tourism_trips")
}


model transport_routes {
  route_id             String  @id @db.Uuid
  transport_type       String  @db.VarChar(50)
  route_name           String  @db.VarChar(255)
  origin_city_id       String  @db.Uuid
  origin_hub_id        String  @db.Uuid
  destination_city_id  String  @db.Uuid
  destination_hub_id   String  @db.Uuid
  distance_km          Decimal @db.Decimal(10,2)
  travel_time          String  @db.VarChar(50)
  travel_minutes       Int
  frequency            String  @db.VarChar(50)
  departure_times      String  @db.Text
  capacity             Int
  price                Decimal @db.Decimal(10,2)
  utilization_percent  Decimal @db.Decimal(5,2)
  efficiency_score     Decimal @db.Decimal(5,2)
  carbon_footprint_kg  Decimal @db.Decimal(10,2)

  // Relaciones
  origin_city          cities          @relation("origin_city", fields: [origin_city_id], references: [id])
  destination_city     cities          @relation("destination_city", fields: [destination_city_id], references: [id])
  origin_hub          infrastructure  @relation("origin_hub", fields: [origin_hub_id], references: [id])
  destination_hub     infrastructure  @relation("destination_hub", fields: [destination_hub_id], references: [id])
  tourism_trips       tourism_trips[]

  @@map("transport_routes")
}

model music {
  id               String   @id @db.Text
  artists          String?  @db.Text
  album_name       String?  @db.Text
  track_name       String?  @db.Text
  duration_ms      BigInt?
  explicit         Boolean?
  danceability     Float?
  energy           Float?
  key              BigInt?
  loudness         Float?
  mode             BigInt?
  speechiness      Float?
  acousticness     Float?
  instrumentalness Float?
  liveness         Float?
  valence          Float?
  tempo            Float?
  time_signature   BigInt?
  track_genre      String?  @db.Text

  // Relación inversa
  people_music     people_music[]

  @@map("music")
}

model people {
  id                String   @id @db.Uuid
  city_id           String   @db.Uuid
  first_name        String   @db.Text
  last_name         String   @db.Text
  birth_date        DateTime @db.Date
  job_sector        String   @db.Text
  education         String?  @db.Text
  employment_status String?  @db.Text
  income            Int?
  personality       String   @db.Text
  // Relaciones
  city              cities      @relation(fields: [city_id], references: [id])
  reviews           review[]
  tourism_trips     tourism_trips[]
  people_music      people_music[]
  vip_network_data  vip_network_data[]

  @@map("people")
}

model people_music {
  people_id String @db.Uuid
  music_id  String @db.Text

  // Relaciones
  people    people @relation(fields: [people_id], references: [id], onDelete: Cascade)
  music     music  @relation(fields: [music_id], references: [id], onDelete: Cascade)

  @@id([people_id, music_id])
  @@map("people_music")
}

model vip_network_data {
  id                            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                       String   @db.Uuid
  ip_origin                     String?  @db.Inet
  ip_destination                String?  @db.Inet
  protocol                      String?  @db.VarChar(20)
  port_origin                   Int?
  port_destination              Int?
  bytes_sent                    BigInt?
  bytes_received                BigInt?
  latency_ms                    Float?
  jitter_ms                     Float?
  error_count                   Int?
  retransmissions               Int?
  connection_establishment_time Float?
  ttl                           Int?
  round_trip_time               Float?
  packet_loss                   Float?
  throughput                    BigInt?
  connection_duration           Float?
  device_type                   String?  @db.VarChar(50)
  brand                         String?  @db.VarChar(50)
  model                         String?  @db.VarChar(50)
  os                            String?  @db.VarChar(50)
  network_interface             String?  @db.VarChar(50)
  app_type                      String?  @db.VarChar(50)
  website_name                  String?  @db.VarChar(100)
  site_category                 String?  @db.VarChar(100)
  service_type                  String?  @db.VarChar(50)
  client_type                   String?  @db.VarChar(50)
  timestamp                     DateTime @default(now()) @db.Timestamptz(6)

  // Relaciones
  people                        people   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("vip_network_data")
}

model review {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  people_id   String   @db.Uuid
  infra_id    String   @db.Uuid
  datetime    DateTime @default(now()) @db.Timestamptz(6)
  description String?
  stars       Int?

  // Relaciones
  people      people   @relation(fields: [people_id], references: [id], onDelete: Cascade)
  infrastructure infrastructure @relation(fields: [infra_id], references: [id], onDelete: Cascade)

  @@index([datetime], name: "idx_review_datetime")
  @@index([infra_id], name: "idx_review_infra_id")
  @@index([people_id], name: "idx_review_people_id")
  @@map("review")
}

model city_borders {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  city_id      String    @unique @db.Uuid
  vertices     String
  area_km2     Decimal
  bounding_box Decimal[]

  // Relaciones
  cities       cities    @relation(fields: [city_id], references: [id])

  @@index([city_id], name: "idx_city_borders_city_id")
  @@map("city_borders")
}
model cities {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String?  @db.VarChar(255)
  capital           Boolean?
  state_id          String?  @db.Uuid
  has_harbor        Boolean? @default(false)
  location          String?  @db.Text

  // Relaciones
  states            states?  @relation(fields: [state_id], references: [id])
  people            people[]
  sensors           sensor[]
  origin_routes     transport_routes[] @relation("origin_city")
  destination_routes transport_routes[] @relation("destination_city")
  roads_as_origin   road[] @relation("OriginCity")
  roads_as_target   road[] @relation("TargetCity")
  infrastructure    infrastructure[]
  electric_vehicles electric_rental_vehicle[]
  parcels           parcels[]
  city_borders      city_borders?
  events            event[]

  @@map("cities")
}


model parcels {
  parcel_id    String  @id @db.VarChar(100)
  city_id      String  @db.Uuid
  area_m2      Decimal @db.Decimal(15,2)
  centroid_lat Decimal @db.Decimal(10,6)
  centroid_lon Decimal @db.Decimal(10,6)
  vertices     String  @db.Text

  // Relaciones
  cities       cities  @relation(fields: [city_id], references: [id], onDelete: Cascade)

  @@map("parcels")
}

model states {
  id   String @id @default(dbgenerated()) @db.Uuid
  name String @unique @db.VarChar(255)
  // Relaciones
  cities  cities[]
  sensors sensor[]
  state_borders state_borders[]

  @@map("states")
}

model state_borders {
  id            String    @id @default(dbgenerated()) @db.Uuid
  state_id      String    @unique @db.Uuid
  vertices      String    @db.Text
  area_km2      Decimal   @db.Decimal(15,2)
  bounding_box  Decimal[] @db.Decimal(15,2)
  created_at    DateTime? @default(dbgenerated()) @db.Timestamptz
  updated_at    DateTime? @default(dbgenerated()) @db.Timestamptz

  // Relaciones
  states        states    @relation(fields: [state_id], references: [id])

  @@map("state_borders")
}

model electric_rental_vehicle {
  id                   String   @id @db.Uuid
  city_id              String?  @db.Uuid
  vin                  String?  @db.VarChar(10)
  model_year           Int?
  make                 String?  @db.VarChar(255)
  model                String?  @db.VarChar(255)
  electric_range       Int?
  dol_vehicle_id       BigInt?
  census_tract         BigInt?
  rental_cost_per_hour Decimal? @db.Decimal(5,2)
  capacity             Int?
  type                 String?  @db.VarChar(50)

  // Relaciones
  cities               cities?  @relation(fields: [city_id], references: [id], onDelete: SetNull)

  @@map("electric_rental_vehicle")
}

model infrastructure_school {
  infra_id                           String  @id @db.Uuid
  student_capacity                   Int?
  environmental_education_program    Boolean?
  energy_efficient_lighting          Boolean?
  sustainable_transportation_options Boolean?

  // Relaciones
  infrastructure                     infrastructure @relation(fields: [infra_id], references: [id], onDelete: Cascade)

  @@map("infrastructure_school")
}

model infrastructure_venues {
  infra_id                   String  @id @db.Uuid
  capacity                   Int?
  size                       String? @db.VarChar(20)
  indoor                     Boolean?
  has_parking                Boolean?
  has_public_transport       Boolean?
  year_built                 Int?
  last_renovation_year       Int?
  accessibility_score        Int?
  security_score             Int?
  technology_score           Int?
  comfort_score              Int?
  sustainability_score       Int?
  amenities                  String? @db.Text
  rental_price_per_day       Int?
  has_catering               Boolean?
  has_technical_support      Boolean?
  has_accommodation          Boolean?
  sustainability_rating      Int?
  energy_efficient_lighting  Boolean?
  water_conservation_systems Boolean?
  waste_reduction_program    Boolean?

  // Relaciones
  infrastructure             infrastructure @relation(fields: [infra_id], references: [id], onDelete: Cascade)

  @@map("infrastructure_venues")
}

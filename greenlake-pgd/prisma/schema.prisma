// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////

model infrastructure_daycare {
  infra_id               String   @id @db.Uuid
  child_capacity         Int?
  age_range              String?  @db.VarChar(20)
  organic_food           Boolean?
  eco_friendly_toys      Boolean?
  outdoor_learning_space Boolean?
  // Relación con infrastructure
  infrastructure         infrastructure @relation(fields: [infra_id], references: [id], onDelete: Cascade)

  @@map("infrastructure_daycare")
}


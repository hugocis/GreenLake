/// Modelo para la recolección de datos de red de usuarios VIP
model vip_network_data {
  user_id                       String   @db.Uuid
  ip_origin                     String?  @db.Inet
  ip_destination                String?  @db.Inet
  protocol                      String?  @db.VarChar(20)
  port_origin                   Int?
  port_destination              Int?
  bytes_sent                    BigInt?
  bytes_received                BigInt?
  latency_ms                    Float?
  jitter_ms                     Float?
  error_count                   Int?
  retransmissions               Int?
  connection_establishment_time Float?
  ttl                           Int?
  round_trip_time               Float?
  packet_loss                   Float?
  throughput                    BigInt?
  connection_duration           Float?
  device_type                   String?  @db.VarChar(50)
  brand                         String?  @db.VarChar(50)
  model                         String?  @db.VarChar(50)
  os                            String?  @db.VarChar(50)
  network_interface             String?  @db.VarChar(50)
  app_type                      String?  @db.VarChar(50)
  website_name                  String?  @db.VarChar(100)
  site_category                 String?  @db.VarChar(100)
  service_type                  String?  @db.VarChar(50)
  client_type                   String?  @db.VarChar(50)
  timestamp                     DateTime @default(now()) @db.Timestamptz(6)
  people                        people   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Definir identificador único compuesto para permitir que Prisma maneje esta tabla
  @@id([user_id, timestamp])
  
  // Índices para mejorar el rendimiento de consultas comunes
  @@index([user_id])
  @@index([timestamp])
  @@index([app_type])
  @@index([service_type])
}

// Modelos para autenticación
model User {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username      String       @unique
  password      String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  settings      UserSettings?
}

model UserSettings {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @db.Uuid
  preferredView String   @default("map") // "map", "list", "table", etc.
  darkMode      Boolean  @default(false)
  language      String   @default("es")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

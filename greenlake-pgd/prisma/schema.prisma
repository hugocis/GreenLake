// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////

model Infrastructure_daycare {
  infra_id              String  @id @default(uuid())
  child_capacity        Int
  eco_friendly_toys     Boolean
  age_range             String  @db.VarChar(20)
  organic_food          Boolean
  outdoor_learning_space Boolean
}

model Infrastructure_auto_service {
  infra_id              String  @id @default(uuid())
  eco_friendly_services Boolean
  electric_vehicle_charging Boolean
  bay_count             Int
  recycling_program     Boolean
}

model Infrastructure_government_building {
  infra_id                   String  @id @default(uuid())
  green_roof                 Boolean
  energy_efficient_heating   Boolean
  water_conservation_systems Boolean
}

model Infrastructure_laundromat {
  infra_id                  String  @id @default(uuid())
  washer_count              Int
  dryer_count               Int
  is_24hour                 Boolean
  energy_efficient_machines Boolean
  water_recycling_system    Boolean
  eco_friendly_detergents   Boolean
}

model Infrastructure_healthcare_clinic {
  infra_id                    String  @id @default(uuid())
  examination_rooms           Int
  telemedicine_capabilities   Boolean
  sustainable_waste_disposal  Boolean
  staff_count                 Int
  energy_efficient_medical_equipment Boolean
}

model Infrastructure_gas_station {
  infra_id                String  @id @default(uuid())
  electric_vehicle_charging Boolean
  biofuel_availability    Boolean
  pump_count              Int
  has_convenience_store   Boolean
  solar_powered           Boolean
}

model Events {
  id                             Int     @id @default(autoincrement())
  has_emergency_exits            Boolean
  has_first_aid                  Boolean
  has_smoking_area               Boolean
  virtual_attendance_option      Boolean
  early_bird_discount            Boolean
  senior_discount_available      Boolean
  setup_days_required            Int
  local_accommodation_partners   Int
  return_attendee_percentage     Float
  early_registration_discount_percentage Float
  // Aquí puedes agregar las otras 80 columnas que menciona el diagrama...
}
model Sensor {
  id                  String                     @id @default(uuid())                             @map("id")
  installedAt         DateTime                   @map("installed_at")
  cityId              String                     @map("city_id")
  location            Unsupported("GEOGRAPHY(POINT,4326)")                     @map("location")
  kmPoint             Float                      @map("km_point")
  sensorType          String                     @map("sensor_type")
  stateId             String                     @map("state_id")
  roadId              String?                    @map("road_id")
  industrialZone      Boolean                    @map("industrial_zone")

  ambientMetrics      SensorMetricsAmbient[]     @relation("AmbientOnSensor")
  trafficMetrics      SensorMetricsTraffic[]     @relation("TrafficOnSensor")
  airMetrics          SensorMetricsAir[]         @relation("AirOnSensor")
  waterUsageMetrics   SensorMetricsWaterUsage[]  @relation("WaterUsageOnSensor")
  waterQualityMetrics SensorMetricsWaterQuality[]@relation("WaterQualityOnSensor")

  @@map("sensors")
}

model SensorMetricsAmbient {
  sensorId       String   @map("sensor_id")
  eventTime      DateTime @map("event_time")
  temperature    Float
  humidity       Float
  solarRadiation Float   @map("solar_radiation")

  sensor Sensor @relation("AmbientOnSensor", fields: [sensorId], references: [id])

  @@id([sensorId, eventTime])
  @@map("sensor_metrics_ambient")
}

model SensorMetricsTraffic {
  sensorId        String   @map("sensor_id")
  eventTime       DateTime @map("event_time")
  vehicleDensity  Float    @map("vehicle_density")
  avgSpeed        Float    @map("avg_speed")
  flowRate        Float    @map("flow_rate")
  occupancy       Float
  congestionIndex Float    @map("congestion_index")

  sensor Sensor @relation("TrafficOnSensor", fields: [sensorId], references: [id])

  @@id([sensorId, eventTime])
  @@map("sensor_metrics_traffic")
}

model SensorMetricsAir {
  sensorId  String   @map("sensor_id")
  eventTime DateTime @map("event_time")
  pm10      Float
  co        Float
  co2       Float
  no2       Float
  o3        Float
  so2       Float

  sensor Sensor @relation("AirOnSensor", fields: [sensorId], references: [id])

  @@id([sensorId, eventTime])
  @@map("sensor_metrics_air")
}

model SensorMetricsWaterUsage {
  sensorId    String   @map("sensor_id")
  eventTime   DateTime @map("event_time")
  usageLiters Float    @map("usage_liters")

  sensor Sensor @relation("WaterUsageOnSensor", fields: [sensorId], references: [id])

  @@id([sensorId, eventTime])
  @@map("sensor_metrics_water_usage")
}

model SensorMetricsWaterQuality {
  sensorId        String   @map("sensor_id")
  eventTime       DateTime @map("event_time")
  waterTemperature Float   @map("water_temperature")
  phLevel          Float   @map("ph_level")
  turbidity        Float
  dissolvedOxygen  Float   @map("dissolved_oxygen")
  conductivity     Float

  sensor Sensor @relation("WaterQualityOnSensor", fields: [sensorId], references: [id])

  @@id([sensorId, eventTime])
  @@map("sensor_metrics_water_quality")
}
